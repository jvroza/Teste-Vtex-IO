{
  "footer": {
    "blocks": ["footer-layout.desktop", "footer-layout.mobile"]
  },
  "footer-layout.desktop": {
    "children": ["flex-layout.row#footer"]
  },
  "footer-layout.mobile": {
    "children": ["flex-layout.row#footer"]
  },
  "flex-layout.row#footer": {
    "props": {
      "fullWidth": true,
      "blockClass": "footer-row"
    },
    "children": [
      "rich-text#footer-copy"
    ]
  },
  "rich-text#footer-copy": {
    "props": {
      "text": "© 2026 Grow Store. Todos os direitos reservados.",
      "textAlignment": "CENTER",
      "textPosition": "CENTER",
      "blockClass": "footer-text"
    }
  }
}