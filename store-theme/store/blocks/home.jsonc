{
  "store.home": {
    "blocks": [
      "rich-text#banner",
      "shelf#home"
    ]
  },

  "rich-text#banner": {
    "props": {
      "text": "### Bem-vindo à Growdev Store",
      "textAlignment": "CENTER",
      "textPosition": "CENTER",
      "font": "t-heading-2"
    }
  },

  "shelf#home": {
    "blocks": ["product-summary.shelf"],
    "props": {
      "orderBy": "OrderByTopSaleDESC",
      "productList": {
        "maxItems": 4,
        "scroll": "BY_PAGE",
        "arrows": true,
        "titleText": "Produtos em destaque"
      }
    }
  }
}